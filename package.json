{
  "name": "effect-workshop-socrates-2026",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test:basics": "vitest run --dir src/exercises/1-basics",
    "test:basics:solutions": "vitest run --dir src/solutions/1-basics",
    "test:w:basics": "vitest watch --dir src/exercises/1-basics",
    "test:w:basics:solutions": "vitest watch --dir src/solutions/1-basics",
    "test:api": "vitest run --dir src/exercises/2-api",
    "test:api:solutions": "vitest run --dir src/solutions/2-api",
    "test:w:api": "vitest watch --dir src/exercises/2-api",
    "test:w:api:solutions": "vitest watch --dir src/solutions/2-api",
    "test:api:e2e": "vitest run --config vitest.e2e.config.mjs --dir src/exercises/2-api",
    "test:api:e2e:solutions": "vitest run --config vitest.e2e.config.mjs --dir src/solutions/2-api",
    "test:w:api:e2e": "vitest watch --config vitest.e2e.config.mjs --dir src/exercises/2-api",
    "test:w:api:e2e:solutions": "vitest watch --config vitest.e2e.config.mjs --dir src/solutions/2-api",
    "typecheck": "tsc --noEmit",
    "typecheck:w": "tsc --noEmit --watch",
    "start:api": "node --watch src/exercises/2-api/main.ts",
    "start:api:solutions": "node --watch src/solutions/2-api/main.ts",
    "prepare": "effect-tsgo patch --typescript --oxlint"
  },
  "devDependencies": {
    "@effect/tsgo": "0.44.0",
    "@types/node": "24.0.0",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-rc.113",
    "effect": "4.0.0-rc.113"
  }
}
